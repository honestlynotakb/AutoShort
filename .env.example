# ==============================================================================
# Environment Configuration Template for Autonomous YouTube Shorts
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to git!
# ==============================================================================

# Google Gemini API Key (Required for Gate 1 Dynamic AI Script Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 OAuth Credentials (Optional if publishing via Zapier)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token
